DATABASE_URL=postgresql+asyncpg://at:at@localhost:5432/at
# Optional — not required for boot or GET /health
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LLM trio (NVIDIA NIM primary + Gemini fallback/embeddings — copy values from .env.demo locally)
# LLM_MODEL=nvidia_nim/nvidia/nemotron-3-nano-30b-a3b
# LLM_API_KEY=
# LLM_API_BASE=https://integrate.api.nvidia.com/v1
# LLM_MODEL_FALLBACKS=nvidia_nim/nvidia/nemotron-3-super-120b-a12b,gemini/gemini-2.5-flash
# GEMINI_API_KEY=
# EMBEDDING_MODEL=gemini/gemini-embedding-2
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# ENVIRONMENT=local
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=agentic-trip/0.1 (local; contact: dev@localhost)
# NOMINATIM_TIMEOUT_SECONDS=5.0
# DIALOGUE_PREFER_POSTGRES_CHECKPOINTER=false
# Compose api sets this true so boot applies Alembic before serving.
# APPLY_SCHEMA_ON_BOOT=true
# Frontend map (optional; demotiles fallback in FE)
# NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
# NEXT_PUBLIC_API_BASE=http://localhost:8000
# GENERATE_TIMEOUT_SECONDS=120
# REVISE_MAX_LOOPS=3
# REVISE_TIMEOUT_SECONDS=120
